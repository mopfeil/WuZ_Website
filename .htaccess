# Wissenschaft und Zauberkunst – Apache-Konfiguration für Hostinger
ErrorDocument 404 /404.html

# HTTPS erzwingen
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# MIME-Typen für PWA-Dateien
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

# Caching: Assets lang, HTML kurz
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

# Service Worker der Pendel-App darf nicht lange gecacht werden
<Files "sw.js">
  Header set Cache-Control "no-cache"
</Files>

# Interne Dateien nicht ausliefern
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
